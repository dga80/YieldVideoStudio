# ==============================================================================
# Yield Video Studio — Configuración de Claves y Entorno
# ==============================================================================
# Copia este archivo como `secretos/.env` y define tus claves:

# 1. Google Gemini (Guion y Asistente en tiempo real)
# Consigue tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_de_gemini

# 2. FreeSound (Efectos de sonido con licencia libre)
# Consigue tu clave en: https://freesound.org/apiv2/apply
FREESOUND_CLIENT_ID=tu_freesound_client_id
FREESOUND_API_KEY=tu_freesound_api_key

# 3. Jamendo (Música de fondo y cama sonora)
# Consigue tu Client ID en: https://devportal.jamendo.com/admin/applications
JAMENDO_CLIENT_ID=tu_jamendo_client_id
JAMENDO_CLIENT_SECRET=tu_jamendo_client_secret

# Nota: La locución usa Microsoft Edge-TTS (gratuito e integrado localmente, sin claves).
